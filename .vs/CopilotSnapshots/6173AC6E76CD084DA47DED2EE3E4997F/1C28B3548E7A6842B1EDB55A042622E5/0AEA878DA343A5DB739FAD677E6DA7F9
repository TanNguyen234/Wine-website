<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StrongWine | Cửa hàng rượu vang</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-modern py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/home">
            <span class="brand-logo"><i class="fa-solid fa-wine-glass"></i></span>
            <span class="fw-semibold">StrongWine</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto ms-lg-4">
                <li class="nav-item"><a class="nav-link active" href="/home">Trang chủ</a></li>
                <li class="nav-item"><a class="nav-link" href="/wines">Sản phẩm</a></li>
            </ul>
            <form class="d-flex me-3" action="/wines" method="get">
                <input class="form-control form-control-sm" type="search" name="name" placeholder="Tìm kiếm rượu vang...">
            </form>
            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" href="/cart"><i class="fa-solid fa-cart-shopping"></i> <span class="badge text-bg-light text-dark" th:text="${cartCount}">0</span></a></li>
                <li class="nav-item" sec:authorize="!isAuthenticated()"><a class="nav-link" href="/login">Đăng nhập</a></li>
                <li class="nav-item" sec:authorize="!isAuthenticated()"><a class="nav-link" href="/register">Đăng ký</a></li>
                <li class="nav-item" sec:authorize="hasRole('ADMIN')"><a class="nav-link" href="/admin">Quản trị</a></li>
                <li class="nav-item" sec:authorize="isAuthenticated()">
                    <form th:action="@{/logout}" method="post"><button class="btn btn-sm btn-outline-light">Đăng xuất</button></form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 my-lg-5">
    <div th:if="${success}" class="alert alert-success" th:text="${success}"></div>
    <div th:if="${error}" class="alert alert-danger" th:text="${error}"></div>
    <section class="hero-modern mb-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Tinh tuyển rượu vang cao cấp cho gu thưởng thức hiện đại.</h1>
                <p class="lead text-light-emphasis mb-4">Khám phá vang đỏ, trắng, hồng và vang sủi với thanh toán an toàn và tồn kho theo thời gian thực.</p>
                <a href="/wines" class="btn btn-light btn-lg px-4">Khám phá sản phẩm</a>
            </div>
        </div>
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Bộ sưu tập nổi bật</h2>
            <a href="/wines" class="text-decoration-none">Xem tất cả</a>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4" th:each="wine : ${featuredWines}">
                <article class="product-card h-100">
                    <img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}" alt="Wine image" class="w-100" style="height: 260px; object-fit: cover;">
                    <div th:unless="${wine.imageUrl != null}" class="d-flex align-items-center justify-content-center bg-light" style="height: 260px;"><i class="fa-regular fa-image fs-1 text-muted"></i></div>
                    <div class="p-3 d-flex flex-column h-100">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge text-bg-dark" th:text="${wine.type}">Type</span>
                            <span class="badge text-bg-secondary" th:text="${wine.year}">Year</span>
                        </div>
                        <h3 class="h6" th:text="${wine.name}">Wine</h3>
                        <p class="price-tag mb-2" th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">0 đ</p>
                        <div class="mb-3">
                            <span th:with="stock=${availableStockByWineId[wine.id]}"
                                  th:class="${stock > 20 ? 'stock-badge stock-ok' : (stock > 0 ? 'stock-badge stock-low' : 'stock-badge stock-out')}"
                                  th:text="${stock > 20 ? 'Còn hàng: ' + stock : (stock > 0 ? 'Sắp hết: ' + stock : 'Hết hàng')}"></span>
                        </div>
                        <div class="d-flex gap-2 mt-auto">
                            <a th:href="@{/wines/{id}(id=${wine.id})}" class="btn btn-outline-dark flex-fill">Xem chi tiết</a>
                            <form th:action="@{/cart/add/{id}(id=${wine.id})}" method="post" class="flex-fill">
                                <input type="hidden" name="redirectTo" value="/home">
                                <button class="btn btn-dark w-100" th:disabled="${availableStockByWineId[wine.id] <= 0}">Thêm vào giỏ</button>
                            </form>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
</main>

<button id="aiToggle" class="ai-fab" title="AI tư vấn"><i class="fa-solid fa-robot"></i></button>
<section id="aiPanel" class="ai-panel p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI Tư vấn rượu vang</h6>
    </div>
    <div id="aiFeed" class="border rounded p-2 mb-2" style="max-height: 180px; overflow-y: auto; background: #f8fafc;"></div>
    <div class="d-flex gap-2 mb-2">
        <button class="btn btn-sm btn-light border" data-ai-question="Gợi ý một chai vang đỏ khô">Vang đỏ khô</button>
        <button class="btn btn-sm btn-light border" data-ai-question="Gợi ý rượu dùng với hải sản">Hải sản</button>
    </div>
    <form id="aiForm" class="d-flex gap-2">
        <input id="aiPrompt" class="form-control form-control-sm" placeholder="Hỏi gợi ý rượu vang...">
        <button class="btn btn-sm btn-dark" type="submit">Gửi</button>
    </form>
</section>

<footer class="text-center py-4 text-muted small">© 2026 StrongWine. Tất cả quyền được bảo lưu.</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/ai-assistant.js"></script>
</body>
</html>
