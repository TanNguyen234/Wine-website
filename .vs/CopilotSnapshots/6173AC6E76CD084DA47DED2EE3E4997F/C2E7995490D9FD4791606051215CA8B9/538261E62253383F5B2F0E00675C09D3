<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${wine.name + ' | StrongWine'}">StrongWine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-modern py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/home"><span class="brand-logo"><i class="fa-solid fa-wine-glass"></i></span><span class="fw-semibold">StrongWine</span></a>
        <div class="ms-auto"><a class="nav-link text-white" href="/cart"><i class="fa-solid fa-cart-shopping"></i></a></div>
    </div>
</nav>

<main class="container my-4">
    <section class="row g-4 mb-4">
        <div class="col-lg-6">
            <div class="panel p-2">
                <img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}" class="w-100 rounded" style="height:520px;object-fit:cover;" alt="Wine">
                <div th:unless="${wine.imageUrl != null}" class="d-flex align-items-center justify-content-center bg-light rounded" style="height:520px;"><i class="fa-regular fa-image fs-1 text-muted"></i></div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="panel p-4 h-100">
                <div class="d-flex gap-2 mb-2">
                    <span class="badge text-bg-dark" th:text="${wine.type}"></span>
                    <span class="badge text-bg-secondary" th:text="${wine.year}"></span>
                    <span th:class="${availableStock > 20 ? 'stock-badge stock-ok' : (availableStock > 0 ? 'stock-badge stock-low' : 'stock-badge stock-out')}"
                          th:text="${availableStock > 20 ? 'In stock' : (availableStock > 0 ? 'Low stock' : 'Out of stock')}"></span>
                </div>
                <h1 class="h3" th:text="${wine.name}"></h1>
                <p class="price-tag mb-3" th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}"></p>
                <div class="mb-4">
                    <h2 class="h6 text-uppercase text-muted">Description</h2>
                    <p class="mb-0" th:text="${wine.description}"></p>
                </div>
                <form th:action="@{/cart/add/{id}(id=${wine.id})}" method="post" class="d-flex gap-2 align-items-center">
                    <input type="number" class="form-control" style="max-width:120px;" name="quantity" value="1" min="1" th:attr="max=${availableStock}">
                    <button class="btn btn-dark btn-lg" th:disabled="${availableStock <= 0}"><i class="fa-solid fa-cart-plus me-1"></i>Add to cart</button>
                </form>
            </div>
        </div>
    </section>

    <section class="panel p-4">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h5 mb-0">Customer Reviews</h2>
            <span class="text-muted small" th:text="${reviews.size()} + ' reviews'"></span>
        </div>
        <div th:if="${reviews.isEmpty()}" class="alert alert-light border">No reviews yet.</div>
        <div th:each="review : ${reviews}" class="border rounded p-3 mb-3">
            <div class="d-flex justify-content-between">
                <strong th:text="${review.user.username}"></strong>
                <small class="text-muted" th:text="${#temporals.format(review.createdAt, 'dd/MM/yyyy HH:mm')}"></small>
            </div>
            <div class="text-warning mb-1">
                <span th:each="i : ${#numbers.sequence(1, 5)}" th:text="${i <= review.rating ? '★' : '☆'}"></span>
            </div>
            <p class="mb-0" th:text="${review.comment}"></p>
        </div>

        <div sec:authorize="isAuthenticated()" class="mt-4">
            <h3 class="h6">Write a review</h3>
            <form th:action="@{/reviews/create}" method="post" class="row g-2">
                <input type="hidden" name="wineId" th:value="${wine.id}">
                <div class="col-md-2"><select class="form-select" name="rating" required><option value="5">5</option><option value="4">4</option><option value="3">3</option><option value="2">2</option><option value="1">1</option></select></div>
                <div class="col-md-8"><input name="comment" class="form-control" placeholder="Share your tasting note" required></div>
                <div class="col-md-2"><button class="btn btn-dark w-100">Submit</button></div>
            </form>
        </div>
    </section>
</main>

<button id="aiToggle" class="ai-fab" title="AI pairing"><i class="fa-solid fa-robot"></i></button>
<section id="aiPanel" class="ai-panel p-3">
    <h6><i class="fa-solid fa-sparkles me-1"></i> AI Pairing</h6>
    <div id="aiFeed" class="border rounded p-2 mb-2" style="max-height:160px;overflow-y:auto;"></div>
    <div class="d-flex gap-2 mb-2"><button class="btn btn-sm btn-light border" data-ai-question="Suggest food pairing for this wine">Food pairing</button></div>
    <form id="aiForm" class="d-flex gap-2"><input id="aiPrompt" class="form-control form-control-sm" placeholder="Ask pairing question"><button class="btn btn-sm btn-dark">Ask</button></form>
</section>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/ai-assistant.js"></script>
</body>
</html>
