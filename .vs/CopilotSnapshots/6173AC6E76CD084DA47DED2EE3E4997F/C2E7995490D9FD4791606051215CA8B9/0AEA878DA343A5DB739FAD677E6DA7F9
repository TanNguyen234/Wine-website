<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>StrongWine | Wine Store</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-modern py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/home">
            <span class="brand-logo"><i class="fa-solid fa-wine-glass"></i></span>
            <span class="fw-semibold">StrongWine</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto ms-lg-4">
                <li class="nav-item"><a class="nav-link active" href="/home">Home</a></li>
                <li class="nav-item"><a class="nav-link" href="/wines">Catalog</a></li>
            </ul>
            <form class="d-flex me-3" action="/wines" method="get">
                <input class="form-control form-control-sm" type="search" name="name" placeholder="Search wines...">
            </form>
            <ul class="navbar-nav align-items-lg-center gap-lg-2">
                <li class="nav-item"><a class="nav-link" href="/cart"><i class="fa-solid fa-cart-shopping"></i></a></li>
                <li class="nav-item" sec:authorize="!isAuthenticated()"><a class="nav-link" href="/login">Login</a></li>
                <li class="nav-item" sec:authorize="!isAuthenticated()"><a class="nav-link" href="/register">Register</a></li>
                <li class="nav-item" sec:authorize="hasRole('ADMIN')"><a class="nav-link" href="/admin">Admin</a></li>
                <li class="nav-item" sec:authorize="isAuthenticated()">
                    <form th:action="@{/logout}" method="post"><button class="btn btn-sm btn-outline-light">Logout</button></form>
                </li>
            </ul>
        </div>
    </div>
</nav>

<main class="container my-4 my-lg-5">
    <section class="hero-modern mb-5">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <h1 class="display-5 fw-bold mb-3">Curated premium wines for modern taste.</h1>
                <p class="lead text-light-emphasis mb-4">Shop reds, whites, rosé, and sparkling labels with secure checkout and real-time stock visibility.</p>
                <a href="/wines" class="btn btn-light btn-lg px-4">Explore Catalog</a>
            </div>
        </div>
    </section>

    <section>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">Featured Collection</h2>
            <a href="/wines" class="text-decoration-none">View all</a>
        </div>
        <div class="row g-4">
            <div class="col-md-6 col-lg-4" th:each="wine : ${featuredWines}">
                <article class="product-card h-100">
                    <img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}" alt="Wine image" class="w-100" style="height: 260px; object-fit: cover;">
                    <div th:unless="${wine.imageUrl != null}" class="d-flex align-items-center justify-content-center bg-light" style="height: 260px;"><i class="fa-regular fa-image fs-1 text-muted"></i></div>
                    <div class="p-3 d-flex flex-column h-100">
                        <div class="d-flex justify-content-between mb-2">
                            <span class="badge text-bg-dark" th:text="${wine.type}">Type</span>
                            <span class="badge text-bg-secondary" th:text="${wine.year}">Year</span>
                        </div>
                        <h3 class="h6" th:text="${wine.name}">Wine</h3>
                        <p class="price-tag mb-2" th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">0 đ</p>
                        <div class="mb-3">
                            <span th:with="stock=${availableStockByWineId[wine.id]}"
                                  th:class="${stock > 20 ? 'stock-badge stock-ok' : (stock > 0 ? 'stock-badge stock-low' : 'stock-badge stock-out')}"
                                  th:text="${stock > 20 ? 'In stock: ' + stock : (stock > 0 ? 'Low stock: ' + stock : 'Out of stock')}"></span>
                        </div>
                        <a th:href="@{/wines/{id}(id=${wine.id})}" class="btn btn-outline-dark mt-auto">View product</a>
                    </div>
                </article>
            </div>
        </div>
    </section>
</main>

<button id="aiToggle" class="ai-fab" title="AI Sommelier"><i class="fa-solid fa-robot"></i></button>
<section id="aiPanel" class="ai-panel p-3">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h6 class="mb-0"><i class="fa-solid fa-wand-magic-sparkles me-1"></i> AI Sommelier</h6>
    </div>
    <div id="aiFeed" class="border rounded p-2 mb-2" style="max-height: 180px; overflow-y: auto; background: #f8fafc;"></div>
    <div class="d-flex gap-2 mb-2">
        <button class="btn btn-sm btn-light border" data-ai-question="Recommend a dry red wine">Dry red</button>
        <button class="btn btn-sm btn-light border" data-ai-question="Suggest wine for seafood">Seafood</button>
    </div>
    <form id="aiForm" class="d-flex gap-2">
        <input id="aiPrompt" class="form-control form-control-sm" placeholder="Ask for wine recommendations...">
        <button class="btn btn-sm btn-dark" type="submit">Send</button>
    </form>
</section>

<footer class="text-center py-4 text-muted small">© 2026 StrongWine</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/ai-assistant.js"></script>
</body>
</html>
