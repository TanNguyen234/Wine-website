:root {
    --bg: #0f172a;
    --surface: #ffffff;
    --muted: #64748b;
    --brand: #7f1d1d;
    --brand-soft: #fef2f2;
}

body {
    font-family: Inter, "Segoe UI", Roboto, Arial, sans-serif;
    background: #f8fafc;
    color: #0f172a;
}

.navbar-modern {
    background: rgba(15, 23, 42, 0.92);
    backdrop-filter: blur(8px);
}

.brand-logo {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    background: linear-gradient(135deg, #ef4444, #7f1d1d);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #fff;
}

.hero-modern {
    background: radial-gradient(circle at top right, #7f1d1d, #1f2937 55%, #0f172a 100%);
    color: #fff;
    border-radius: 24px;
    padding: 3rem;
}

.product-card {
    border: 1px solid #e2e8f0;
    border-radius: 16px;
    overflow: hidden;
    background: #fff;
    transition: transform .2s ease, box-shadow .2s ease;
}

.product-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(15, 23, 42, .12);
}

.price-tag {
    color: #7f1d1d;
    font-weight: 700;
    font-size: 1.15rem;
}

.stock-badge {
    border-radius: 999px;
    font-size: .75rem;
    font-weight: 600;
    padding: .35rem .7rem;
}

.stock-ok { background: #dcfce7; color: #166534; }
.stock-low { background: #fef3c7; color: #92400e; }
.stock-out { background: #fee2e2; color: #991b1b; }

.panel {
    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 16px;
}

.ai-fab {
    position: fixed;
    right: 24px;
    bottom: 24px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    border: none;
    background: linear-gradient(135deg, #7f1d1d, #b91c1c);
    color: #fff;
    box-shadow: 0 10px 24px rgba(127, 29, 29, .45);
    z-index: 1080;
}

.ai-panel {
    position: fixed;
    right: 24px;
    bottom: 96px;
    width: 340px;
    max-width: calc(100vw - 32px);
    border-radius: 16px;
    background: #fff;
    border: 1px solid #e2e8f0;
    box-shadow: 0 24px 50px rgba(15, 23, 42, .2);
    display: none;
    z-index: 1080;
}

.ai-panel.show { display: block; }

.table-modern thead th {
    background: #f1f5f9;
    border-bottom: 0;
}
