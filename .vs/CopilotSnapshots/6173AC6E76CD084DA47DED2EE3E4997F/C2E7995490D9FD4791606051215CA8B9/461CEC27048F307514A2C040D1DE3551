<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cart - StrongWine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark navbar-modern py-3">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/home">
                <span class="brand-logo"><i class="fa-solid fa-wine-glass"></i></span> StrongWine
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/wines">Danh sách rượu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/cart">
                            <i class="fa-solid fa-cart-shopping"></i> Giỏ hàng
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/login">Đăng nhập</a>
                    </li>
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/register">Đăng ký</a>
                    </li>
                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">
                        <a class="nav-link" href="/admin">Bảng điều khiển Admin</a>
                    </li>
                    <li class="nav-item" sec:authorize="isAuthenticated()">
                        <form th:action="@{/logout}" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <h2 class="mb-4 fw-bold"><i class="fa-solid fa-cart-shopping"></i> Giỏ hàng của bạn</h2>

        <div th:if="${empty}" class="alert alert-info">
            <i class="bi bi-info-circle"></i> Giỏ hàng của bạn đang trống. 
            <a href="/wines" class="alert-link">Xem danh sách rượu</a> để thêm sản phẩm.
        </div>

        <div th:unless="${empty}">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 15%;">Hình ảnh</th>
                                    <th>Tên rượu</th>
                                    <th>Giá</th>
                                    <th>Số lượng</th>
                                    <th>Thành tiền</th>
                                    <th>Thao tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr th:each="entry : ${cartItems}">
                                    <td>
                                        <img th:if="${entry.key.imageUrl != null}" 
                                             th:src="${entry.key.imageUrl}" 
                                             class="img-fluid rounded" 
                                             style="width: 80px; height: 80px; object-fit: cover;" 
                                             alt="Hình ảnh rượu">
                                        <div th:unless="${entry.key.imageUrl != null}" 
                                             class="bg-secondary rounded d-flex align-items-center justify-content-center" 
                                             style="width: 80px; height: 80px;">
                                            <i class="bi bi-image text-white"></i>
                                        </div>
                                    </td>
                                    <td>
                                        <a th:href="@{/wines/{id}(id=${entry.key.id})}" 
                                           class="text-decoration-none fw-semibold" 
                                           th:text="${entry.key.name}">Tên rượu</a>
                                    </td>
                                    <td th:text="${#numbers.formatDecimal(entry.key.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">Giá</td>
                                    <td>
                                        <form th:action="@{/cart/update/{id}(id=${entry.key.id})}" method="post" class="d-inline-flex align-items-center gap-2">
                                            <input type="number" name="quantity" th:value="${entry.value}" min="1" class="form-control" style="width: 80px;">
                                            <button type="submit" class="btn btn-sm btn-primary">
                                                <i class="bi bi-arrow-repeat"></i> Cập nhật
                                            </button>
                                        </form>
                                    </td>
                                    <td class="fw-bold text-primary" 
                                        th:text="${#numbers.formatDecimal(entry.key.price * entry.value, 0, 'COMMA', 0, 'POINT') + ' đ'}">Thành tiền</td>
                                    <td>
                                        <form th:action="@{/cart/remove/{id}(id=${entry.key.id})}" method="post" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-danger">
                                                <i class="bi bi-trash"></i> Xóa
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th colspan="4" class="text-end">Tổng cộng:</th>
                                    <th class="text-primary fs-5" th:text="${#numbers.formatDecimal(total, 0, 'COMMA', 0, 'POINT') + ' đ'}">Tổng</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <a href="/wines" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i> Tiếp tục mua sắm
                        </a>
                        <form th:action="@{/cart/checkout}" method="post" class="d-inline">
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="fa-solid fa-credit-card"></i> Thanh toán
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2025 StrongWine. Tất cả quyền được bảo lưu.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
