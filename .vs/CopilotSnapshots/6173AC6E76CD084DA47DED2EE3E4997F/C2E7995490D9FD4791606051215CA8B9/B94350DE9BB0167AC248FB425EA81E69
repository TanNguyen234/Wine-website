<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - StrongWine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="stylesheet" href="/css/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark navbar-modern py-3">
    <div class="container">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/home">
            <span class="brand-logo"><i class="fa-solid fa-wine-glass"></i></span>
            <span class="fw-semibold">StrongWine Admin</span>
        </a>
        <div class="d-flex align-items-center gap-3">
            <a href="/wines" class="text-white text-decoration-none">Storefront</a>
            <form th:action="@{/logout}" method="post" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
            </form>
        </div>
    </div>
</nav>

<main class="container my-4">
    <div class="row g-3 mb-4">
        <div class="col-lg-2 col-md-4 col-6">
            <div class="panel p-3 h-100">
                <div class="small text-muted">Products</div>
                <div class="h4 mb-0" th:text="${totalWines}">0</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="panel p-3 h-100">
                <div class="small text-muted">Users</div>
                <div class="h4 mb-0" th:text="${totalUsers}">0</div>
            </div>
        </div>
        <div class="col-lg-2 col-md-4 col-6">
            <div class="panel p-3 h-100">
                <div class="small text-muted">Orders</div>
                <div class="h4 mb-0" th:text="${totalOrders}">0</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-6">
            <div class="panel p-3 h-100">
                <div class="small text-muted">Revenue (PAID)</div>
                <div class="h5 mb-0" th:text="${#numbers.formatDecimal(totalRevenue, 0, 'COMMA', 0, 'POINT') + ' đ'}">0</div>
            </div>
        </div>
        <div class="col-lg-3 col-md-6 col-12">
            <div class="panel p-3 h-100 d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-muted">Alerts</div>
                    <div><span class="badge text-bg-warning me-1" th:text="${lowStockCount} + ' low stock'"></span><span class="badge text-bg-info" th:text="${pendingPayments} + ' pending pay'"></span></div>
                </div>
                <i class="fa-solid fa-triangle-exclamation text-warning fs-4"></i>
            </div>
        </div>
    </div>

    <ul class="nav nav-tabs" id="adminTabs" role="tablist">
        <li class="nav-item" role="presentation"><button class="nav-link active" data-bs-toggle="tab" data-bs-target="#products" type="button">Products</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#orders" type="button">Orders</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#inventory" type="button">Inventory</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#payments" type="button">Payments</button></li>
        <li class="nav-item" role="presentation"><button class="nav-link" data-bs-toggle="tab" data-bs-target="#alerts" type="button">Alerts</button></li>
    </ul>

    <div class="tab-content">
        <section class="tab-pane fade show active" id="products">
            <div class="panel p-3 mt-3">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 mb-0">Product Catalog</h2>
                    <a href="/wines/admin/create" class="btn btn-sm btn-dark">Add wine</a>
                </div>
                <div class="row g-3">
                    <div class="col-lg-3 col-md-4" th:each="wine : ${wines}">
                        <article class="product-card h-100">
                            <img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}" class="w-100" style="height:170px;object-fit:cover;" alt="wine">
                            <div th:unless="${wine.imageUrl != null}" class="bg-light d-flex align-items-center justify-content-center" style="height:170px;"><i class="fa-regular fa-image text-muted"></i></div>
                            <div class="p-2">
                                <div class="fw-semibold" th:text="${wine.name}"></div>
                                <div class="small text-muted" th:text="${wine.type + ' - ' + wine.year}"></div>
                                <div class="price-tag small" th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}"></div>
                                <div class="d-flex gap-1 mt-2">
                                    <a class="btn btn-sm btn-outline-dark flex-fill" th:href="@{/wines/admin/edit/{id}(id=${wine.id})}">Edit</a>
                                    <form class="flex-fill" th:action="@{/wines/admin/delete/{id}(id=${wine.id})}" method="post" onsubmit="return confirm('Delete wine?');">
                                        <button class="btn btn-sm btn-outline-danger w-100">Delete</button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </div>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="orders">
            <div class="panel p-3 mt-3">
                <h2 class="h6">Order Management</h2>
                <div class="table-responsive">
                    <table class="table table-modern table-sm align-middle">
                        <thead><tr><th>ID</th><th>User</th><th>Date</th><th>Status</th><th>Payment</th><th>Total</th></tr></thead>
                        <tbody>
                        <tr th:each="order : ${orders}">
                            <td th:text="${order.id}"></td>
                            <td th:text="${order.user.username}"></td>
                            <td th:text="${#temporals.format(order.orderDate, 'dd/MM/yyyy HH:mm')}"></td>
                            <td><span class="badge text-bg-secondary" th:text="${order.status}"></span></td>
                            <td><span class="badge text-bg-info" th:text="${order.paymentStatus}"></span></td>
                            <td th:text="${#numbers.formatDecimal(order.totalPrice, 0, 'COMMA', 0, 'POINT') + ' đ'}"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="inventory">
            <div class="panel p-3 mt-3">
                <h2 class="h6">Inventory Management</h2>
                <div class="table-responsive mb-4">
                    <table class="table table-modern table-sm align-middle">
                        <thead><tr><th>Wine</th><th>Warehouse</th><th>Current</th><th>Reserved</th><th>Available</th><th>Reorder Level</th><th>Import/Export</th></tr></thead>
                        <tbody>
                        <tr th:each="inv : ${inventories}">
                            <td th:text="${inv.wine.name}"></td>
                            <td th:text="${inv.warehouse.name}"></td>
                            <td th:text="${inv.currentQuantity}"></td>
                            <td th:text="${inv.reservedQuantity}"></td>
                            <td>
                                <span th:class="${inv.availableQuantity <= inv.reorderLevel ? 'stock-badge stock-low' : 'stock-badge stock-ok'}"
                                      th:text="${inv.availableQuantity}"></span>
                            </td>
                            <td th:text="${inv.reorderLevel}"></td>
                            <td>
                                <div class="d-flex flex-column gap-1">
                                    <form class="d-flex gap-1" th:action="@{/admin/inventory/import/{wineId}(wineId=${inv.wine.id})}" method="post">
                                        <input class="form-control form-control-sm" type="number" min="1" name="quantity" value="10" style="max-width:90px;">
                                        <input class="form-control form-control-sm" name="note" placeholder="note" style="max-width:130px;">
                                        <button class="btn btn-sm btn-outline-success">Import</button>
                                    </form>
                                    <form class="d-flex gap-1" th:action="@{/admin/inventory/export/{wineId}(wineId=${inv.wine.id})}" method="post">
                                        <input class="form-control form-control-sm" type="number" min="1" name="quantity" value="5" style="max-width:90px;">
                                        <input class="form-control form-control-sm" name="note" placeholder="note" style="max-width:130px;">
                                        <button class="btn btn-sm btn-outline-danger">Export</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="h6">Inventory Transactions</h3>
                <div class="table-responsive">
                    <table class="table table-modern table-sm align-middle">
                        <thead><tr><th>Time</th><th>Wine</th><th>Operation</th><th>Qty</th><th>User ID</th><th>Reference</th></tr></thead>
                        <tbody>
                        <tr th:each="tx : ${inventoryTransactions}">
                            <td th:text="${#temporals.format(tx.createdAt, 'dd/MM/yyyy HH:mm')}"></td>
                            <td th:text="${tx.wine.name}"></td>
                            <td th:text="${tx.operationType}"></td>
                            <td th:text="${tx.quantity}"></td>
                            <td th:text="${tx.userId}"></td>
                            <td th:text="${tx.referenceType + (tx.referenceId != null ? (' #' + tx.referenceId) : '')}"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="payments">
            <div class="panel p-3 mt-3">
                <h2 class="h6">Payment Transactions</h2>
                <div class="table-responsive mb-4">
                    <table class="table table-modern table-sm align-middle">
                        <thead><tr><th>Created</th><th>Order</th><th>Reference</th><th>Method</th><th>Status</th><th>Amount</th></tr></thead>
                        <tbody>
                        <tr th:each="pay : ${payments}">
                            <td th:text="${#temporals.format(pay.createdAt, 'dd/MM/yyyy HH:mm')}"></td>
                            <td th:text="${pay.order.id}"></td>
                            <td th:text="${pay.paymentReference}"></td>
                            <td th:text="${pay.method}"></td>
                            <td><span class="badge text-bg-secondary" th:text="${pay.status}"></span></td>
                            <td th:text="${#numbers.formatDecimal(pay.amount, 0, 'COMMA', 0, 'POINT') + ' đ'}"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>

                <h3 class="h6">Payment Event Log</h3>
                <div class="table-responsive">
                    <table class="table table-modern table-sm align-middle">
                        <thead><tr><th>Time</th><th>Type</th><th>Status</th><th>Payload</th></tr></thead>
                        <tbody>
                        <tr th:each="ptx : ${paymentTransactions}">
                            <td th:text="${#temporals.format(ptx.createdAt, 'dd/MM/yyyy HH:mm')}"></td>
                            <td th:text="${ptx.transactionType}"></td>
                            <td th:text="${ptx.status}"></td>
                            <td class="small text-muted" th:text="${ptx.payload}"></td>
                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="alerts">
            <div class="panel p-3 mt-3">
                <h2 class="h6">Low Stock Alerts</h2>
                <div th:if="${lowStockItems.isEmpty()}" class="alert alert-success mb-0">No low stock products.</div>
                <div th:unless="${lowStockItems.isEmpty()}" class="list-group">
                    <div class="list-group-item" th:each="item : ${lowStockItems}">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <strong th:text="${item.wine.name}"></strong>
                                <div class="small text-muted" th:text="${item.warehouse.name}"></div>
                            </div>
                            <span class="stock-badge stock-low" th:text="${'Available: ' + item.availableQuantity}"></span>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
