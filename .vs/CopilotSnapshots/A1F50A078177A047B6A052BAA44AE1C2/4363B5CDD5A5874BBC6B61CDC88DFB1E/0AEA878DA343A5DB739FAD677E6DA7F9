<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Trang chủ - StrongWine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
    <style>
        .hero-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            padding: 80px 0;
        }
        .wine-card {
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }
        .wine-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(0,0,0,0.15);
        }
    </style>
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/home">
                <i class="bi bi-cup-hot"></i> StrongWine
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link active" href="/home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/wines">Danh sách rượu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">
                            <i class="bi bi-cart"></i> Giỏ hàng
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/login">Đăng nhập</a>
                    </li>
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/register">Đăng ký</a>
                    </li>
                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">
                        <a class="nav-link" href="/admin">Bảng điều khiển Admin</a>
                    </li>
                    <li class="nav-item" sec:authorize="isAuthenticated()">
                        <form th:action="@{/logout}" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Hero Section -->
    <div class="hero-section text-white text-center mb-5">
        <div class="container">
            <h1 class="display-4 fw-bold mb-3">Chào mừng đến với StrongWine</h1>
            <p class="lead mb-4">Khám phá bộ sưu tập rượu vang tuyệt vời từ khắp nơi trên thế giới</p>
            <a href="/wines" class="btn btn-light btn-lg px-5">
                <i class="bi bi-search"></i> Xem danh sách rượu
            </a>
        </div>
    </div>

    <!-- Featured Wines -->
    <div class="container my-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold">Rượu nổi bật</h2>
        </div>
        <div class="row g-4">
            <div th:each="wine : ${featuredWines}" class="col-md-4 col-sm-6">
                <div class="card h-100 wine-card shadow-sm border-0">
                    <img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}" 
                         class="card-img-top img-fluid" 
                         style="height: 250px; object-fit: cover;" 
                         alt="Hình ảnh rượu">
                    <div th:unless="${wine.imageUrl != null}" 
                         class="card-img-top bg-secondary d-flex align-items-center justify-content-center" 
                         style="height: 250px;">
                        <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                    </div>
                    <div class="card-body d-flex flex-column">
                        <h5 class="card-title fw-bold" th:text="${wine.name}">Tên rượu</h5>
                        <p class="card-text">
                            <span class="badge bg-secondary me-1" th:text="${wine.type}">Loại</span>
                            <span class="badge bg-info" th:text="${wine.year}">Năm</span>
                        </p>
                        <p class="card-text fw-bold text-primary fs-5 mb-3" th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">Giá</p>
                        <a th:href="@{/wines/{id}(id=${wine.id})}" class="btn btn-primary mt-auto">
                            <i class="bi bi-eye"></i> Xem chi tiết
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="text-center mt-5">
            <a href="/wines" class="btn btn-outline-primary btn-lg px-5">
                <i class="bi bi-list-ul"></i> Xem tất cả rượu
            </a>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2025 StrongWine. Tất cả quyền được bảo lưu.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
