<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org" xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title th:text="${wine.name + ' - StrongWine'}">Chi tiết rượu - StrongWine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/home">
                <i class="bi bi-cup-hot"></i> StrongWine
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/home">Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/wines">Danh sách rượu</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/cart">
                            <i class="bi bi-cart"></i> Giỏ hàng
                        </a>
                    </li>
                </ul>
                <ul class="navbar-nav">
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/login">Đăng nhập</a>
                    </li>
                    <li class="nav-item" sec:authorize="!isAuthenticated()">
                        <a class="nav-link" href="/register">Đăng ký</a>
                    </li>
                    <li class="nav-item" sec:authorize="hasRole('ADMIN')">
                        <a class="nav-link" href="/admin">Bảng điều khiển Admin</a>
                    </li>
                    <li class="nav-item" sec:authorize="isAuthenticated()">
                        <form th:action="@{/logout}" method="post" class="d-inline">
                            <button type="submit" class="btn btn-link nav-link">Đăng xuất</button>
                        </form>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container my-4">
        <div class="row g-4">
            <div class="col-md-5">
                <div class="card shadow-sm border-0">
                    <img th:if="${wine.imageUrl != null}" 
                         th:src="${wine.imageUrl}" 
                         class="img-fluid rounded-top" 
                         alt="Hình ảnh rượu" 
                         style="max-height: 500px; width: 100%; object-fit: cover;">
                    <div th:unless="${wine.imageUrl != null}" 
                         class="bg-secondary d-flex align-items-center justify-content-center rounded-top" 
                         style="height: 500px;">
                        <i class="bi bi-image text-white" style="font-size: 5rem;"></i>
                    </div>
                </div>
            </div>
            <div class="col-md-7">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <h2 class="card-title fw-bold mb-3" th:text="${wine.name}">Tên rượu</h2>
                        <p class="mb-3">
                            <span class="badge bg-secondary me-2" th:text="${wine.type}">Loại</span>
                            <span class="badge bg-info" th:text="${wine.year}">Năm</span>
                        </p>
                        <h3 class="text-primary fw-bold mb-4" 
                            th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">Giá</h3>
                        <div class="mb-4">
                            <h5 class="fw-semibold">Mô tả</h5>
                            <p class="text-muted" th:text="${wine.description}">Mô tả</p>
                        </div>

                        <form th:action="@{/cart/add/{id}(id=${wine.id})}" method="post" class="mt-4">
                            <div class="input-group mb-3" style="max-width: 250px;">
                                <span class="input-group-text"><i class="bi bi-123"></i> Số lượng</span>
                                <input type="number" class="form-control" name="quantity" value="1" min="1">
                            </div>
                            <button type="submit" class="btn btn-success btn-lg px-5">
                                <i class="bi bi-cart-plus"></i> Thêm vào giỏ hàng
                            </button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reviews Section -->
        <div class="mt-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-light">
                    <h3 class="mb-0"><i class="bi bi-star"></i> Đánh giá</h3>
                </div>
                <div class="card-body">
                    <div th:if="${reviews.isEmpty()}" class="alert alert-info">
                        <i class="bi bi-info-circle"></i> Chưa có đánh giá nào. Hãy là người đầu tiên đánh giá!
                    </div>
                    <div th:each="review : ${reviews}" class="card mb-3 border">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <h6 class="card-title mb-0 fw-semibold" th:text="${review.user.username}">Tên người dùng</h6>
                                <small class="text-muted" th:text="${#temporals.format(review.createdAt, 'dd/MM/yyyy HH:mm')}">Ngày</small>
                            </div>
                            <div class="mb-2">
                                <span th:each="i : ${#numbers.sequence(1, 5)}" 
                                      class="text-warning fs-5" 
                                      th:classappend="${i <= review.rating} ? 'bi bi-star-fill' : 'bi bi-star'">
                                    ★
                                </span>
                                <span class="ms-2 fw-semibold" th:text="${review.rating + '/5'}"></span>
                            </div>
                            <p class="card-text mb-0" th:text="${review.comment}">Bình luận</p>
                        </div>
                    </div>

                    <!-- Add Review Form (for authenticated users) -->
                    <div sec:authorize="isAuthenticated()" class="card mt-4 border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0"><i class="bi bi-pencil-square"></i> Viết đánh giá</h5>
                        </div>
                        <div class="card-body">
                            <form th:action="@{/reviews/create}" method="post">
                                <input type="hidden" name="wineId" th:value="${wine.id}">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Đánh giá <span class="text-danger">*</span></label>
                                    <select class="form-select" name="rating" required>
                                        <option value="1">1 sao</option>
                                        <option value="2">2 sao</option>
                                        <option value="3">3 sao</option>
                                        <option value="4">4 sao</option>
                                        <option value="5" selected>5 sao</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Bình luận <span class="text-danger">*</span></label>
                                    <textarea class="form-control" name="comment" rows="4" placeholder="Chia sẻ ý kiến của bạn về sản phẩm này..." required></textarea>
                                </div>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-send"></i> Gửi đánh giá
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-dark text-light text-center py-4 mt-5">
        <div class="container">
            <p class="mb-0">&copy; 2025 StrongWine. Tất cả quyền được bảo lưu.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
