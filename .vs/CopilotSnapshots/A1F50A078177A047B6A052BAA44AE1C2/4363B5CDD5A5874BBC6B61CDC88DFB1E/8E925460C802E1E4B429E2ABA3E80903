<!DOCTYPE html>
<html xmlns:th="http://www.thymeleaf.org"
	xmlns:sec="http://www.thymeleaf.org/extras/spring-security">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Danh sách rượu - StrongWine</title>
<link
	href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
	rel="stylesheet">
<link rel="stylesheet"
	href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
<style>
.wine-card {
	transition: transform 0.3s ease, box-shadow 0.3s ease;
}

.wine-card:hover {
	transform: translateY(-5px);
	box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
}
</style>
</head>
<body>
	<!-- Navigation -->
	<nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">
		<div class="container">
			<a class="navbar-brand fw-bold" href="/home"> <i
				class="bi bi-cup-hot"></i> StrongWine
			</a>
			<button class="navbar-toggler" type="button"
				data-bs-toggle="collapse" data-bs-target="#navbarNav">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse" id="navbarNav">
				<ul class="navbar-nav me-auto">
					<li class="nav-item"><a class="nav-link" href="/home">Trang
							chủ</a></li>
					<li class="nav-item"><a class="nav-link active" href="/wines">Danh
							sách rượu</a></li>
					<li class="nav-item"><a class="nav-link" href="/cart"> <i
							class="bi bi-cart"></i> Giỏ hàng
					</a></li>
				</ul>
				<ul class="navbar-nav">
					<li class="nav-item" sec:authorize="!isAuthenticated()"><a
						class="nav-link" href="/login">Đăng nhập</a></li>
					<li class="nav-item" sec:authorize="!isAuthenticated()"><a
						class="nav-link" href="/register">Đăng ký</a></li>
					<li class="nav-item" sec:authorize="hasRole('ADMIN')"><a
						class="nav-link" href="/admin">Bảng điều khiển Admin</a></li>
					<li class="nav-item" sec:authorize="isAuthenticated()">
						<form th:action="@{/logout}" method="post" class="d-inline">
							<button type="submit" class="btn btn-link nav-link">Đăng
								xuất</button>
						</form>
					</li>
				</ul>
			</div>
		</div>
	</nav>

	<div class="container my-4">
		<h2 class="mb-4 fw-bold">Bộ sưu tập rượu</h2>

		<!-- Search and Filter Form -->
		<div class="card shadow-sm mb-4 border-0">
			<div class="card-header bg-primary text-white">
				<h5 class="mb-0">
					<i class="bi bi-search"></i> Tìm kiếm và lọc
				</h5>
			</div>
			<div class="card-body">
				<form method="get" action="/wines" class="row g-3">
					<div class="col-md-3 col-sm-6">
						<label class="form-label fw-semibold">Tên rượu</label> <input
							type="text" class="form-control" name="name" th:value="${name}"
							placeholder="Nhập tên rượu">
					</div>
					<div class="col-md-2 col-sm-6">
						<label class="form-label fw-semibold">Loại</label> <select
							class="form-select" name="type">
							<option value="">Tất cả loại</option>
							<option value="Red" th:selected="${type == 'Red'}">Đỏ</option>
							<option value="White" th:selected="${type == 'White'}">Trắng</option>
							<option value="Rose" th:selected="${type == 'Rose'}">Hồng</option>
							<option value="Sparkling" th:selected="${type == 'Sparkling'}">Có
								ga</option>
						</select>
					</div>
					<div class="col-md-2 col-sm-6">
						<label class="form-label fw-semibold">Năm</label> <input
							type="number" class="form-control" name="year" th:value="${year}"
							placeholder="Năm">
					</div>
					<div class="col-md-2 col-sm-6">
						<label class="form-label fw-semibold">Giá tối thiểu</label> <input
							type="number" step="0.01" class="form-control" name="minPrice"
							th:value="${minPrice}" placeholder="Giá min">
					</div>
					<div class="col-md-2 col-sm-6">
						<label class="form-label fw-semibold">Giá tối đa</label> <input
							type="number" step="0.01" class="form-control" name="maxPrice"
							th:value="${maxPrice}" placeholder="Giá max">
					</div>
					<div class="col-md-1 col-sm-6 d-flex align-items-end">
						<button type="submit" class="btn btn-primary w-100">
							<i class="bi bi-search"></i> Tìm
						</button>
					</div>
				</form>
			</div>
		</div>

		<!-- Wine List -->
		<div class="row g-4">
			<div th:each="wine : ${wines}" class="col-md-4 col-sm-6">
				<div class="card h-100 wine-card shadow-sm border-0">
					<img th:if="${wine.imageUrl != null}" th:src="${wine.imageUrl}"
						class="card-img-top img-fluid"
						style="height: 280px; object-fit: cover;" alt="Hình ảnh rượu">
					<div th:unless="${wine.imageUrl != null}"
						class="card-img-top bg-secondary d-flex align-items-center justify-content-center"
						style="height: 280px;">
						<i class="bi bi-image text-white" style="font-size: 3rem;"></i>
					</div>
					<div class="card-body d-flex flex-column">
						<h5 class="card-title fw-bold" th:text="${wine.name}">Tên
							rượu</h5>
						<p class="card-text">
							<span class="badge bg-secondary me-1" th:text="${wine.type}">Loại</span>
							<span class="badge bg-info" th:text="${wine.year}">Năm</span>
						</p>
						<p class="card-text fw-bold text-primary fs-5 mb-2"
							th:text="${#numbers.formatDecimal(wine.price, 0, 'COMMA', 0, 'POINT') + ' đ'}">Giá</p>
						<p class="card-text text-muted small"
							th:text="${wine.description != null ? (wine.description.length() > 100 ? wine.description.substring(0, 100) + '...' : wine.description) : ''}">
							Mô tả</p>
						<div class="d-flex gap-2 mt-auto">
							<a th:href="@{/wines/{id}(id=${wine.id})}"
								class="btn btn-primary flex-fill"> <i class="bi bi-eye"></i>
								Chi tiết
							</a>
							<form th:action="@{/cart/add/{id}(id=${wine.id})}" method="post"
								class="d-inline flex-fill">
								<button type="submit" class="btn btn-success w-100">
									<i class="bi bi-cart-plus"></i> Thêm
								</button>
							</form>
						</div>
					</div>
				</div>
			</div>
		</div>

		<div th:if="${wines.isEmpty()}" class="alert alert-info mt-4">
			<i class="bi bi-info-circle"></i> Không tìm thấy rượu nào phù hợp với
			tiêu chí của bạn.
		</div>
	</div>

	<!-- Footer -->
	<footer class="bg-dark text-light text-center py-4 mt-5">
		<div class="container">
			<p class="mb-0">&copy; 2025 StrongWine. Tất cả quyền được bảo
				lưu.</p>
		</div>
	</footer>

	<script
		src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
