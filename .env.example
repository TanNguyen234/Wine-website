# SQL Server Database
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=winestore_2;encrypt=true;trustServerCertificate=true
DB_USERNAME=sa
DB_PASSWORD=123456

# JWT
APP_JWT_SECRET=change-this-jwt-secret-to-at-least-32-bytes
APP_JWT_EXPIRATION_MS=86400000

# Stripe
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLIC_KEY=pk_test_your_public_key_here
